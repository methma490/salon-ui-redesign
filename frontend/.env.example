VITE_API_BASE_URL=https://saloon-server.bc.dartcodes.com/api
# Public marketing website (Next.js) for pricing / home links from signup
VITE_WEBSITE_URL=http://localhost:3001
# Optional: Google Maps API key for address search autocomplete
VITE_GOOGLE_MAPS_API_KEY=
# Optional: OpenRouteService API key (https://openrouteservice.org) for Pelias address geocoding & autocomplete (fallback to OpenStreetMap Nominatim/Photon if omitted)
VITE_OPENROUTESERVICE_API_KEY=
# Optional: obscure platform (super admin) login URL — default is /platform/access
# VITE_PLATFORM_LOGIN_PATH=/platform/access

