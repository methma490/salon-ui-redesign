NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://salon_user:salon_password@localhost:5432/salon_saas?schema=public"

# Auto-run migrations (+ seed when DB is empty) on backend startup
DATABASE_AUTO_SETUP=true

FRONTEND_URL=http://localhost:5173

# Email (password reset). Without SMTP, reset links are logged to the backend console in dev.
MAIL_FROM=Salon360 <noreply@salon360.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
PASSWORD_RESET_DEV_LOG=true

# Set AUTH_DEBUG=true to log login lookup details (email found, hash present, bcrypt result)
AUTH_DEBUG=false

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SUPER_ADMIN_NAME=System Administrator
SUPER_ADMIN_EMAIL=admin@system.local
SUPER_ADMIN_PASSWORD=StrongPassword123!

# Plan seed pricing (Phase 2 — used by prisma db seed)
SEED_PLAN_CURRENCY=LKR
SEED_SILVER_MONTHLY_PRICE=5000
SEED_SILVER_YEARLY_PRICE=50000
SEED_SILVER_TRIAL_DAYS=14
SEED_GOLD_MONTHLY_PRICE=15000
SEED_GOLD_YEARLY_PRICE=150000
SEED_GOLD_TRIAL_DAYS=14
SEED_PLATINUM_MONTHLY_PRICE=25000
SEED_PLATINUM_YEARLY_PRICE=250000
SEED_PLATINUM_TRIAL_DAYS=14
SEED_CUSTOM_MONTHLY_PRICE=0
SEED_CUSTOM_YEARLY_PRICE=0
SEED_CUSTOM_TRIAL_DAYS=0

# PayHere (https://sandbox.payhere.lk for sandbox)
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_SECRET=your_merchant_secret
# Or: PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_ENV=sandbox
# Or: PAYHERE_SANDBOX=true
# Public URL for PayHere signup notify webhook (use ngrok in local dev)
PAYHERE_NOTIFY_URL=http://localhost:3000/api/payments/payhere/notify
# Subscription renewals/activations use /payments/webhooks/payhere (derived from API_PUBLIC_URL)
# Allow success-page confirmation when notify URL is unreachable (local sandbox only)
PAYHERE_ALLOW_RETURN_CONFIRM=true
# Optional: public API base if different from localhost
API_PUBLIC_URL=http://localhost:3000/api

# Invoice issuer details (Phase 5)
INVOICE_ISSUER_NAME=Salon360
INVOICE_ISSUER_EMAIL=billing@salon360.local
INVOICE_ISSUER_ADDRESS=Colombo, Sri Lanka

# Redis + BullMQ notifications (Phase 6)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
NOTIFICATION_QUEUE_NAME=notifications
NOTIFICATION_REMINDER_CRON=0 9 * * *
# SMS_PROVIDER=twilio
